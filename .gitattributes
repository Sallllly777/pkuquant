# Frozen manifests hash exact bytes; do not change them at checkout.
* whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.py -text
*.json -text
*.jsonl -text
*.csv -text
*.gz binary
*.png binary
docs/checks/** -text
# Keep original legacy bytes, including the historical blank line at EOF.
legacy/** -text whitespace=blank-at-eol,space-before-tab,cr-at-eol,-blank-at-eof
